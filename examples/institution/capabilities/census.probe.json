{
  "apiVersion": "continuity.powerfarm.dev/v2alpha1",
  "kind": "CapabilityProfile",
  "metadata": {
    "name": "census.probe",
    "version": "0"
  },
  "spec": {
    "contract": {
      "kind": "openapi",
      "ref": "urn:powerfarm:capability:census.probe",
      "op": "census.probe"
    },
    "effect": {
      "class": "reconcilable",
      "verification": {
        "capability": "census.verify",
        "expect": {
          "recorded": true
        },
        "timeout": "70s"
      }
    },
    "authorization": {
      "mode": "policy"
    }
  }
}
