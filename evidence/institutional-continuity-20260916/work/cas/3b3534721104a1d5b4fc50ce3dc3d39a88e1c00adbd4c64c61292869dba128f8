"package heartime\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nconst base int64 = 1800000000\n\nfunc fixture() Contract {\n\treturn Contract{\"powerfarm.specs/v0\", \"HeartimeContract\", Metadata{\"pf.contract.heartime.test\", 1, \"pf.powerfarm\", \"pf.danvoulez\"}, Terms{ObligationID: \"build\", Responsibility: Ref{\"pf.contract.exec.build\", 1}, Recurrence: Recurrence{utc(base), 10}, GraceSeconds: 2, CatchUp: \"all\", MaxBatch: 100, Overlap: \"defer\", ReviewAfterSeconds: 20, Handoff: Ref{\"pf.contract.exec.build\", 1}, Fallback: Fallback{\"safe_mode\", 10, Ref{\"pf.contract.exec.recover\", 1}}, Planning: Planning{utc(base + 100), utc(base + 70), 20, Ref{\"pf.contract.exec.plan\", 1}}}}\n}\nfunc setup(t *testing.T, c Contract) (*Store, string) {\n\tt.Helper()\n\tpath := filepath.Join(t.TempDir(), \"state.db\")\n\ts, e := Open(path)\n\tmust(t, e)\n\tt.Cleanup(func() { s.Close() })\n\tmust(t, s.Install(c, base))\n\treturn s, path\n}\nfunc must(t *testing.T, e error) {\n\tt.Helper()\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n}\nfunc count(t *testing.T, s *Store, where string) int {\n\tt.Helper()\n\tvar n int\n\tmust(t, s.db.QueryRow(\"SELECT COUNT(*) FROM occurrences WHERE \"+where).Scan(&n))\n\treturn n\n}\nfunc first(t *testing.T, s *Store) string {\n\tt.Helper()\n\tvar id string\n\tmust(t, s.db.QueryRow(\"SELECT id FROM occurrences WHERE kind='work' ORDER BY nominal LIMIT 1\").Scan(&id))\n\treturn id\n}\nfunc TestPersistBeforePublishAndRestart(t *testing.T) {\n\ts, path := setup(t, fixture())\n\tmust(t, s.Evaluate(base))\n\tid := first(t, s)\n\tmust(t, s.Close())\n\ts2, e := Open(path)\n\tmust(t, e)\n\tdefer s2.Close()\n\tmust(t, s2.Evaluate(base))\n\tif first(t, s2) != id || count(t, s2, \"kind='work'\") != 1 {\n\t\tt.Fatal(\"recreated semantic occurrence\")\n\t}\n\tp, e := s2.Pending()\n\tmust(t, e)\n\tif len(p) != 1 || p[0].Attempts != 0 {\n\t\tt.Fatal(p)\n\t}\n\tnext, e := s2.NextEvaluation()\n\tmust(t, e)\n\tif next != base+10 {\n\t\tt.Fatal(next)\n\t}\n}\nfunc TestSIGKILLAfterCommit(t *testing.T) {\n\tif path := os.Getenv(\"HEARTIME_KILL_DB\"); path != \"\" {\n\t\ts, e := Open(path)\n\t\tif e != nil {\n\t\t\tos.Exit(2)\n\t\t}\n\t\tif e = s.Evaluate(base); e != nil {\n\t\t\tos.Exit(3)\n\t\t}\n\t\tos.WriteFile(path+\".ready\", []byte(\"committed\"), 0600)\n\t\tselect {}\n\t}\n\ts, path := setup(t, fixture())\n\tcmd := exec.Command(os.Args[0], \"-test.run=^TestSIGKILLAfterCommit$\")\n\tcmd.Env = append(os.Environ(), \"HEARTIME_KILL_DB=\"+path)\n\tmust(t, cmd.Start())\n\tt.Cleanup(func() { cmd.Process.Kill() })\n\tdeadline := time.Now().Add(10 * time.Second)\n\tfor {\n\t\tif _, e := os.Stat(path + \".ready\"); e == nil {\n\t\t\tbreak\n\t\t}\n\t\tif time.Now().After(deadline) {\n\t\t\tt.Fatal(\"child never committed\")\n\t\t}\n\t\ttime.Sleep(10 * time.Millisecond)\n\t}\n\tmust(t, cmd.Process.Kill())\n\tif cmd.Wait() == nil {\n\t\tt.Fatal(\"expected killed process\")\n\t}\n\tmust(t, s.Evaluate(base))\n\tif count(t, s, \"kind='work'\") != 1 {\n\t\tt.Fatal(\"duplicate after SIGKILL\")\n\t}\n}\nfunc TestCatchUp(t *testing.T) {\n\tfor _, mode := range []string{\"all\", \"latest\", \"skip\"} {\n\t\tt.Run(mode, func(t *testing.T) {\n\t\t\tc := fixture()\n\t\t\tc.Spec.CatchUp = mode\n\t\t\tc.Spec.MaxBatch = 2\n\t\t\ts, _ := setup(t, c)\n\t\t\tmust(t, s.Evaluate(base+35))\n\t\t\tswitch mode {\n\t\t\tcase \"all\":\n\t\t\t\tif count(t, s, \"kind='work'\") != 2 {\n\t\t\t\t\tt.Fatal(\"batch\")\n\t\t\t\t}\n\t\t\t\tmust(t, s.Evaluate(base+35))\n\t\t\t\tif count(t, s, \"kind='work'\") != 4 {\n\t\t\t\t\tt.Fatal(\"backlog lost\")\n\t\t\t\t}\n\t\t\tcase \"latest\":\n\t\t\t\tvar nominal, n int64\n\t\t\t\tmust(t, s.db.QueryRow(\"SELECT nominal,covered_count FROM occurrences WHERE kind='work'\").Scan(&nominal, &n))\n\t\t\t\tif nominal != base+30 || n != 4 {\n\t\t\t\t\tt.Fatal(nominal, n)\n\t\t\t\t}\n\t\t\tcase \"skip\":\n\t\t\t\tif count(t, s, \"kind='work' AND state='skipped'\") != 1 {\n\t\t\t\t\tt.Fatal(\"skip evidence\")\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestOverlap(t *testing.T) {\n\tfor _, mode := range []string{\"allow\", \"defer\", \"coalesce\"} {\n\t\tt.Run(mode, func(t *testing.T) {\n\t\t\tc := fixture()\n\t\t\tc.Spec.Overlap = mode\n\t\t\ts, _ := setup(t, c)\n\t\t\tmust(t, s.Evaluate(base))\n\t\t\tid := first(t, s)\n\t\t\tmust(t, s.Attempt(id, base))\n\t\t\tmust(t, s.Acknowledge(id, base))\n\t\t\tmust(t, s.Evaluate(base+10))\n\t\t\tvar next string\n\t\t\tmust(t, s.db.QueryRow(\"SELECT id FROM occurrences WHERE kind='work' AND nominal=?\", base+10).Scan(&next))\n\t\t\te := s.Attempt(next, base+10)\n\t\t\tif mode == \"allow\" {\n\t\t\t\tmust(t, e)\n\t\t\t} else if e == nil {\n\t\t\t\tt.Fatal(\"overlap escaped\")\n\t\t\t}\n\t\t\tmust(t, s.Report(id, \"verified\", Digest([]byte(\"verified by independent observer\")), base+10))\n\t\t\tif mode != \"allow\" {\n\t\t\t\tmust(t, s.Attempt(next, base+10))\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestCoalesceUnpublishedOnly(t *testing.T) {\n\tc := fixture()\n\tc.Spec.Overlap = \"coalesce\"\n\ts, _ := setup(t, c)\n\tmust(t, s.Evaluate(base+20))\n\tvar id string\n\tmust(t, s.db.QueryRow(\"SELECT id FROM occurrences WHERE kind='work' ORDER BY nominal DESC LIMIT 1\").Scan(&id))\n\tmust(t, s.Attempt(id, base+20))\n\tif count(t, s, \"state='coalesced'\") != 2 {\n\t\tt.Fatal(\"not coalesced\")\n\t}\n}\nfunc TestPlanningRollover(t *testing.T) {\n\tc := fixture()\n\ts, _ := setup(t, c)\n\tmust(t, s.Evaluate(base+70))\n\tif count(t, s, \"kind='planning-review'\") != 1 {\n\t\tt.Fatal(\"missing review\")\n\t}\n\tmust(t, s.Renew(c.Metadata.ID, 1, base+200, base+150, Digest([]byte(\"next period plan\")), base+71))\n\tmust(t, s.Evaluate(base+101))\n\tif count(t, s, \"kind='fallback'\") != 0 {\n\t\tt.Fatal(\"renewal lost\")\n\t}\n\tvar end, review int64\n\tmust(t, s.db.QueryRow(\"SELECT coverage,planning_review FROM contracts\").Scan(&end, &review))\n\tif end != base+200 || review != base+150 {\n\t\tt.Fatal(end, review)\n\t}\n}\nfunc TestPlanningFailureAndFutureCoverage(t *testing.T) {\n\ts, _ := setup(t, fixture())\n\tmust(t, s.Evaluate(base+101))\n\tif count(t, s, \"kind='fallback'\") != 1 || count(t, s, \"kind='work' AND state='pending'\") != 0 {\n\t\tt.Fatal(\"work continued outside coverage\")\n\t}\n\tnext, e := s.NextEvaluation()\n\tmust(t, e)\n\tif next <= base+101 {\n\t\tt.Fatal(next)\n\t}\n\tmust(t, s.Evaluate(base+111))\n\tif count(t, s, \"kind='fallback'\") != 2 {\n\t\tt.Fatal(\"fallback silently disappeared\")\n\t}\n}\nfunc TestUncertainEffectAndRestartQuestions(t *testing.T) {\n\ts, path := setup(t, fixture())\n\tmust(t, s.Evaluate(base))\n\tid := first(t, s)\n\tmust(t, s.Attempt(id, base))\n\tmust(t, s.Acknowledge(id, base))\n\tmust(t, s.Close())\n\ts, e := Open(path)\n\tmust(t, e)\n\tdefer s.Close()\n\tstatus, e := s.Status()\n\tmust(t, e)\n\tb, e := json.Marshal(status)\n\tmust(t, e)\n\tif !strings.Contains(string(b), \"acknowledged\") || strings.Contains(string(b), `\"state\":\"verified\"`) {\n\t\tt.Fatal(string(b))\n\t}\n\tmust(t, s.Evaluate(base+21))\n\tif count(t, s, \"kind LIKE 'return-review/%'\") != 1 {\n\t\tt.Fatal(\"lost return watch\")\n\t}\n\tmust(t, s.Evaluate(base+50))\n\tif count(t, s, \"kind LIKE 'return-review/sha256:%'\") > 8 {\n\t\tt.Fatal(\"recursive return reviews\")\n\t}\n}\nfunc TestPauseSupersessionAndOldReturn(t *testing.T) {\n\tc := fixture()\n\ts, _ := setup(t, c)\n\tmust(t, s.Evaluate(base))\n\tid := first(t, s)\n\tmust(t, s.Attempt(id, base))\n\tmust(t, s.Pause(c.Metadata.ID, 1, base+30, base+1, \"maintenance\"))\n\tmust(t, s.Evaluate(base+10))\n\tif count(t, s, \"kind='work'\") != 1 {\n\t\tt.Fatal(\"pause ignored\")\n\t}\n\tc.Metadata.Generation = 2\n\tc.Spec.Recurrence.Anchor = utc(base + 15)\n\tmust(t, s.Install(c, base+11))\n\tmust(t, s.Evaluate(base+22))\n\tif count(t, s, \"generation=1 AND kind LIKE 'return-review/%'\") != 1 {\n\t\tt.Fatal(\"old generation lost its review\")\n\t}\n}\nfunc TestGenerationConflictAndClockRegression(t *testing.T) {\n\tc := fixture()\n\ts, _ := setup(t, c)\n\tc.Spec.Overlap = \"allow\"\n\tif !errors.Is(s.Install(c, base), ErrConflict) {\n\t\tt.Fatal(\"mutated immutable generation\")\n\t}\n\tmust(t, s.Evaluate(base+1))\n\tif !errors.Is(s.Evaluate(base), ErrClock) {\n\t\tt.Fatal(\"clock regression hidden\")\n\t}\n}\nfunc TestReportRequiresEvidenceAndPublication(t *testing.T) {\n\ts, _ := setup(t, fixture())\n\tmust(t, s.Evaluate(base))\n\tid := first(t, s)\n\tif s.Report(id, \"verified\", Digest([]byte(\"x\")), base) == nil {\n\t\tt.Fatal(\"unpublished work verified\")\n\t}\n\tmust(t, s.Attempt(id, base))\n\tif s.Report(id, \"verified\", \"success\", base) == nil {\n\t\tt.Fatal(\"no evidence\")\n\t}\n\td := Digest([]byte(\"receipt\"))\n\tmust(t, s.Report(id, \"verified\", d, base))\n\tmust(t, s.Report(id, \"verified\", d, base))\n\tif !errors.Is(s.Report(id, \"failed\", d, base), ErrConflict) {\n\t\tt.Fatal(\"terminal report reinterpreted\")\n\t}\n}\nfunc TestExpiredWorkCannotBePublished(t *testing.T) {\n\tc := fixture()\n\tc.Spec.ExpiresAt = utc(base + 1)\n\ts, _ := setup(t, c)\n\tmust(t, s.Evaluate(base))\n\tif s.Attempt(first(t, s), base+2) == nil {\n\t\tt.Fatal(\"expired dispatch\")\n\t}\n}\nfunc TestConcurrentEvaluators(t *testing.T) {\n\ts, path := setup(t, fixture())\n\ts2, e := Open(path)\n\tmust(t, e)\n\tdefer s2.Close()\n\tvar wg sync.WaitGroup\n\terrs := make(chan error, 2)\n\tfor _, x := range []*Store{s, s2} {\n\t\twg.Add(1)\n\t\tgo func(x *Store) { defer wg.Done(); errs <- x.Evaluate(base + 10) }(x)\n\t}\n\twg.Wait()\n\tclose(errs)\n\tfor e := range errs {\n\t\tmust(t, e)\n\t}\n\tif count(t, s, \"kind='work'\") != 2 {\n\t\tt.Fatal(\"concurrent duplicate\")\n\t}\n}\nfunc TestStrictContractParsing(t *testing.T) {\n\tc := fixture()\n\tb, e := json.Marshal(c)\n\tmust(t, e)\n\t_, e = Parse(b)\n\tmust(t, e)\n\tif _, e = Parse(append(b, []byte(\"{}\")...)); e == nil {\n\t\tt.Fatal(\"trailing object\")\n\t}\n\tc.Spec.Planning.NextPlanningReviewAt = c.Spec.Planning.PlanValidThrough\n\tif c.Validate() == nil {\n\t\tt.Fatal(\"review at expiry\")\n\t}\n}\n\nfunc TestRelayRealHTTPAcknowledgesWithoutVerifying(t *testing.T) {\n\tc := fixture()\n\tnow := time.Now().UTC().Unix()\n\tc.Spec.Recurrence.Anchor = utc(now)\n\tc.Spec.Planning.PlanValidThrough = utc(now + 100)\n\tc.Spec.Planning.NextPlanningReviewAt = utc(now + 70)\n\ts, e := Open(filepath.Join(t.TempDir(), \"relay.db\"))\n\tmust(t, e)\n\tdefer s.Close()\n\tmust(t, s.Install(c, now))\n\treceived := make(chan string, 1)\n\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tif r.Header.Get(\"Authorization\") != \"Bearer test-token\" {\n\t\t\tt.Error(\"credential missing\")\n\t\t}\n\t\tselect {\n\t\tcase received <- r.Header.Get(\"Idempotency-Key\"):\n\t\tdefault:\n\t\t}\n\t\tw.WriteHeader(202)\n\t}))\n\tdefer server.Close()\n\tctx, cancel := context.WithCancel(context.Background())\n\tdefer cancel()\n\tdone := make(chan error, 1)\n\tgo func() { done <- s.Run(ctx, server.URL, \"test-token\") }()\n\tvar id string\n\tselect {\n\tcase id = <-received:\n\tcase <-time.After(5 * time.Second):\n\t\tt.Fatal(\"no publication\")\n\t}\n\tdeadline := time.Now().Add(time.Second)\n\tfor {\n\t\tvar state string\n\t\tmust(t, s.db.QueryRow(\"SELECT state FROM occurrences WHERE id=?\", id).Scan(&state))\n\t\tif state == \"acknowledged\" {\n\t\t\tbreak\n\t\t}\n\t\tif time.Now().After(deadline) {\n\t\t\tt.Fatal(state)\n\t\t}\n\t\ttime.Sleep(time.Millisecond)\n\t}\n\tcancel()\n\tif e := <-done; !errors.Is(e, context.Canceled) {\n\t\tt.Fatal(e)\n\t}\n\tif count(t, s, \"state='verified'\") != 0 {\n\t\tt.Fatal(\"HTTP acknowledgement became verification\")\n\t}\n}\nfunc TestVerifiedContainmentReleasesOverlapWithoutSuccess(t *testing.T) {\n\ts, _ := setup(t, fixture())\n\tmust(t, s.Evaluate(base))\n\tid := first(t, s)\n\tmust(t, s.Attempt(id, base))\n\tmust(t, s.Report(id, \"failed\", Digest([]byte(\"failure\")), base))\n\tmust(t, s.Evaluate(base+10))\n\tvar next string\n\tmust(t, s.db.QueryRow(\"SELECT id FROM occurrences WHERE nominal=? AND kind='work'\", base+10).Scan(&next))\n\tif s.Attempt(next, base+10) == nil {\n\t\tt.Fatal(\"unresolved failure released overlap\")\n\t}\n\tmust(t, s.Report(id, \"contained\", Digest([]byte(\"independently verified no remaining effects\")), base+10))\n\tmust(t, s.Attempt(next, base+10))\n\tif count(t, s, \"state='verified'\") != 0 {\n\t\tt.Fatal(\"containment invented success\")\n\t}\n}\n"

